# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY: Optional The Movie Database (TMDB) v3 API key (kept strictly backend-only).
# Obtain a free key at https://www.themoviedb.org/settings/api to enable live Indian cinema sync
# and official posters across Kannada, Hindi, Tamil, Telugu, and Malayalam.
TMDB_API_KEY=""

# POSTER_STORAGE_DIR: Optional persistent filesystem directory for admin-uploaded movie posters
# (defaults to ./data/uploads/posters; SQLite also stores a durable binary backup locally).
POSTER_STORAGE_DIR=""

# GCS_BUCKET_NAME: Recommended for Google Cloud Run deployments to store admin-uploaded movie
# posters durably in Google Cloud Storage instead of ephemeral container storage.
# Uses Application Default Credentials (Cloud Run service account) or GOOGLE_APPLICATION_CREDENTIALS.
GCS_BUCKET_NAME=""

# GCS_PUBLIC_BASE_URL: Optional custom CDN / public base URL for the GCS bucket
# (defaults to https://storage.googleapis.com/<GCS_BUCKET_NAME>).
GCS_PUBLIC_BASE_URL=""

